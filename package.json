{
  "name": "@speranto/speranto",
  "version": "0.4.2",
  "license": "MIT",
  "author": "Imre Gelens",
  "homepage": "https://github.com/ImreC/speranto",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImreC/speranto"
  },
  "description": "A quick and simple machine translation tool for i18n in webapps. Translate JSON, JS/TS, Markdown files and database content using OpenAI, Mistral, or Ollama.",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "speranto": "dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs/agent-guide.md",
    "scripts/agent-docs-root.mjs",
    "scripts/install-agent-docs.mjs"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "types": "tsc src/types.ts --declaration --emitDeclarationOnly --outDir dist",
    "build": "tsdown",
    "postinstall": "node ./scripts/install-agent-docs.mjs",
    "link": "pnpm build && pnpm link --global",
    "sync:version": "tsx scripts/version.ts sync",
    "bump:version": "tsx scripts/version.ts",
    "bump:patch": "tsx scripts/version.ts patch",
    "bump:minor": "tsx scripts/version.ts minor",
    "bump:major": "tsx scripts/version.ts major",
    "example:seed": "tsx scripts/seed-example-db.ts",
    "example": "pnpm example:seed && cd example_content && tsx ../index.ts",
    "docker:up": "docker compose -p speranto -f tests/docker-compose.yml up -d --wait",
    "test": "pnpm docker:up && LLM_API_KEY=test vitest run",
    "test:unit": "LLM_API_KEY=test vitest run --exclude tests/database/postgres.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/mdast": "^4.0.4",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "tsdown": "^0.23.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/generator": "^8.0.5",
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@babel/types": "^8.0.5",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sql.js": "^1.14.2",
    "unified": "^11.0.5"
  }
}
